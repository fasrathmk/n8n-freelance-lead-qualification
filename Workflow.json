      "parameters": {
        "jsCode": "const emails = $input.all();\n\nconst qualifiedCount = emails.filter(\n  item => item.json.mailType === \"Qualified\"\n).length;\n\nconst reviewCount = emails.filter(\n  item => item.json.mailType === \"Review\"\n).length;\n\nconst totalCount = qualifiedCount + reviewCount;\n\nreturn [\n  {\n    json: {\n      message: \"Emails sent successfully!\",\n      totalEmailsSent: totalCount,\n      qualifiedEmailsSent: qualifiedCount,\n      reviewEmailsSent: reviewCount\n    }\n  }\n];"
